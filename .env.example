# Local development defaults
DATABASE_URL=postgres://hbba:hbba@localhost:5544/hbba
JWT_SECRET=dev-only-change-me
PORT=3000
NODE_ENV=development

# Optional database pool tuning
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=12000
PG_IDLE_TIMEOUT_MS=30000

# First production admin bootstrap
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Owner User
ADMIN_ORG=HBBA Global

# Public URL used in emails and OAuth redirects
APP_URL=http://localhost:3000

# Eventbrite two-way sync (optional; integration dormant until both set)
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=

# Demo mode: while Stripe/Resend are unset, invoices can be marked paid without
# a card and emails queue to an in-app outbox. Set DEMO_MODE=0 to switch that off.
DEMO_MODE=1

# Email delivery (optional; invites, resets, reminders and campaigns are
# recorded either way, but only delivered when this is set)
RESEND_API_KEY=
EMAIL_FROM=HBBA Global <onboarding@resend.dev>

# Card payments (optional). The webhook secret is what marks invoices paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign in with Google (optional; the button stays hidden until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
