# Local development defaults
DATABASE_URL=postgres://hbba:hbba@localhost:5544/hbba
JWT_SECRET=dev-only-change-me
PORT=3000
NODE_ENV=development

# Optional database pool tuning
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=12000
PG_IDLE_TIMEOUT_MS=30000

# First production admin bootstrap
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Owner User
ADMIN_ORG=HBBA Global

# Public URL used in emails and OAuth redirects
APP_URL=http://localhost:3000

# Eventbrite two-way sync (optional; integration dormant until both set)
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=

# Encrypts integration credentials saved from Settings. Without it the app
# refuses to store them rather than writing plaintext. Keep it with the database:
# a restored backup needs the same key to read what it saved.
SECRETS_KEY=

# Demo mode: while Stripe/Resend are unset, invoices can be marked paid without
# a card and emails queue to an in-app outbox. Set DEMO_MODE=0 to switch that off.
DEMO_MODE=1

# Email delivery (optional; invites, resets, reminders and campaigns are
# recorded either way, but only delivered when one of these is configured).
# Everything below can instead be set from Settings -> Integrations, where it is
# encrypted at rest. A value set here always wins and locks the field in the UI.
#
# Leave EMAIL_TRANSPORT blank to use whichever is configured (SMTP first), or
# set it to smtp or resend to insist on one.
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
RESEND_API_KEY=
EMAIL_FROM=HBBA Global <onboarding@resend.dev>

# Encrypts credentials saved from the UI (AES-256-GCM). Any passphrase will do,
# but it must stay paired with its database: change it and anything already
# stored becomes unreadable.
SECRETS_KEY=

# Card payments (optional). The webhook secret is what marks invoices paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduled campaign delivery. Vercel Cron sends this as a bearer token to
# /api/ops/campaigns/run; without it that route does not exist.
CRON_SECRET=

# Requests allowed per minute from one address. The limiter counts by IP, so a
# whole office behind a single NAT shares one budget. Defaults: 240 and 30.
API_RATE_LIMIT=
AUTH_RATE_LIMIT=
